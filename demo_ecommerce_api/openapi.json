  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "detail",
          "status"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Human-readable error description",
            "example": "sample_detail"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code",
            "example": 101
          },
          "code": {
            "type": "string",
            "description": "Error classification code",
            "example": "sample_code"
          }
        },
        "example": {
          "detail": "sample_detail",
          "status": 101,
          "code": "sample_code"
        }
      },
      "Product": {
        "type": "object",
        "description": "Store merchandise",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "title": {
            "type": "string",
            "example": "Sample title"
          },
          "price": {
            "type": "string",
            "example": "Sample price"
          },
          "stock": {
            "type": "integer",
            "example": 1
          }
        },
        "example": {
          "id": "123e4567-e89b-12d3-a456-426614174000",
          "title": "Sample title",
          "price": "Sample price",
          "stock": 1
        }
      },
      "ProductCreate": {
        "type": "object",
        "description": "Payload for creating a new Product",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Sample title"
          },
          "price": {
            "type": "string",
            "example": "Sample price"
          },
          "stock": {
            "type": "integer",
            "example": 1
          }
        },
        "example": {
          "title": "Sample title",
          "price": "Sample price",
          "stock": 1
        }
      },
      "ProductUpdate": {
        "type": "object",
        "description": "Payload for updating an existing Product",
        "properties": {
          "title": {
            "type": "string",
            "example": "Sample title"
          },
          "price": {
            "type": "string",
            "example": "Sample price"
          },
          "stock": {
            "type": "integer",
            "example": 1
          }
        },
        "example": {
          "title": "Sample title",
          "price": "Sample price",
          "stock": 1
        }
      },
      "ProductListResponse": {
        "type": "object",
        "description": "Paginated list of Product records",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "example": []
          },
          "total": {
            "type": "integer",
            "example": 100
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "offset": {
            "type": "integer",
            "example": 0
          }
        },
        "example": {
          "items": [],
          "total": 100,
          "limit": 20,
          "offset": 0
        }
      },
      "Order": {
        "type": "object",
        "description": "Customer purchase order",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "customer_id": {
            "type": "string",
            "example": "Sample customer_id"
          },
          "total_amount": {
            "type": "string",
            "example": "Sample total_amount"
          },
          "status": {
            "type": "string",
            "example": "Sample status"
          }
        },
        "example": {
          "id": "123e4567-e89b-12d3-a456-426614174000",
          "customer_id": "Sample customer_id",
          "total_amount": "Sample total_amount",
          "status": "Sample status"
        }
      },
      "OrderCreate": {
        "type": "object",
        "description": "Payload for creating a new Order",
        "required": [],
        "properties": {
          "customer_id": {
            "type": "string",
            "example": "Sample customer_id"
          },
          "total_amount": {
            "type": "string",
            "example": "Sample total_amount"
          },
          "status": {
            "type": "string",
            "example": "Sample status"
          }
        },
        "example": {
          "customer_id": "Sample customer_id",
          "total_amount": "Sample total_amount",
          "status": "Sample status"
        }
      },
      "OrderUpdate": {
        "type": "object",
        "description": "Payload for updating an existing Order",
        "properties": {
          "customer_id": {
            "type": "string",
            "example": "Sample customer_id"
          },
          "total_amount": {
            "type": "string",
            "example": "Sample total_amount"
          },
          "status": {
            "type": "string",
            "example": "Sample status"
          }
        },
        "example": {
          "customer_id": "Sample customer_id",
          "total_amount": "Sample total_amount",
          "status": "Sample status"
        }
      },
      "OrderListResponse": {
        "type": "object",
        "description": "Paginated list of Order records",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            },
            "example": []
          },
          "total": {
            "type": "integer",
            "example": 100
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "offset": {
            "type": "integer",
            "example": 0
          }
        },
        "example": {
          "items": [],
          "total": 100,
          "limit": 20,
          "offset": 0
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter JWT Bearer token"
      }
    }
  }
}